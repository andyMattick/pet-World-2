+      steps:[{name:'Find the point', type:'concept', kind:'choice', prompt:`Which point is at ${sgn(ask)}?`, options:shuffle(opts), hint:() => `${sgn(ask)} is ${Math.abs(ask)} to the left of 0.`}]};
