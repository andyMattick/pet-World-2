+function evalProblem(src, vals, {title, bubble, helper}){
+  const tk = ooParse(src, vals), ev = ooEval(tk);
+  if (!ev || ev.steps.some(s => s.r[0] < 0 || s.r[1] > 64 || Math.abs(s.r[0]) > 5000)) return null;
