+/* ===== 6th grade, Market Stall (Khan unit 3): rates and percentages ===== */
+const PRODUCE = [['🍎', 'apples', 'pound'], ['🍐', 'pears', 'pound'], ['🥕', 'carrots', 'bunch'], ['🍓', 'strawberries', 'basket'], ['🥔', 'potatoes', 'pound'], ['🍅', 'tomatoes', 'pound'], ['🌽', 'corn', 'ear'], ['🥬', 'lettuce', 'head']];
